<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RhiLinux.Gui.Views.LibraryView">
  <Grid ColumnDefinitions="*,6">
    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0"
            IsVisible="{Binding ShowLibraryPage}">
      <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="12,12,8,12">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="8,4,8,8">
          <TextBlock Text="Games" Classes="sectionTitle" VerticalAlignment="Center" />
          <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="8,3"
                  Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding FilteredGameCount}" Classes="secondary" FontSize="12" />
          </Border>
          <Button Grid.Column="2" Content="Add game" Classes="compact secondary" Margin="8,0,0,0"
                  Click="AddGame_Click" />
        </Grid>
        <ComboBox Grid.Row="1" ItemsSource="{Binding LibraryFilters}" SelectedItem="{Binding LibraryFilter, Mode=TwoWay}"
                  Margin="4,0,4,8" AutomationProperties.Name="Library filters" />
        <TextBlock Grid.Row="2" IsVisible="{Binding ShowNoMatches}" Text="No games match this search."
                   Classes="secondary" TextWrapping="Wrap" Margin="8,0,16,12" />
        <ListBox Grid.Row="3" x:Name="GameList" Classes="gameList" SelectionMode="Single"
                 ItemsSource="{Binding FilteredGames}" SelectedItem="{Binding SelectedGame, Mode=OneWay}"
                 SelectionChanged="GameList_SelectionChanged"
                 AutomationProperties.Name="Installed games">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="12,10,12,10" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Name}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                <Border Grid.Row="1" Grid.Column="0" Classes="providerChip" HorizontalAlignment="Left" Margin="0,4,0,0"
                        ToolTip.Tip="{Binding IdentitySummary}">
                  <TextBlock Text="{Binding IdentitySummary}" />
                </Border>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ExternalId}" Classes="secondary" FontSize="12"
                           Margin="0,4,0,0" HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
    <GridSplitter Grid.Column="1" x:Name="SidebarSplitter" ResizeDirection="Columns" Background="Transparent"
                  MinWidth="6" Cursor="SizeWestEast" IsVisible="{Binding ShowLibraryPage}" />
  </Grid>
</UserControl>
