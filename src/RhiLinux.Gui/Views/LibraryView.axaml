<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gui="using:RhiLinux.Gui"
             x:Class="RhiLinux.Gui.Views.LibraryView">
  <Grid ColumnDefinitions="*,6">
    <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0"
            IsVisible="{Binding ShowLibraryPage}">
      <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="12,12,8,12">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="8,4,8,8">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="LIBRARY" Classes="eyebrow" VerticalAlignment="Center" />
            <TextBlock Text="{Binding FilteredGameCount}" Classes="eyebrow accent" VerticalAlignment="Center" />
          </StackPanel>
          <Button Grid.Column="2" Content="Add game" Classes="compact secondary" Margin="8,0,0,0"
                  Click="AddGame_Click" />
        </Grid>
        <ComboBox Grid.Row="1" ItemsSource="{Binding LibraryFilters}" SelectedItem="{Binding LibraryFilter, Mode=TwoWay}"
                  Margin="4,0,4,8" AutomationProperties.Name="Library filters" />
        <TextBlock Grid.Row="2" IsVisible="{Binding ShowNoMatches}" Text="No matches. Try a different name or filter."
                   Classes="secondary" TextWrapping="Wrap" Margin="8,0,16,12" />
        <ListBox Grid.Row="3" x:Name="GameList" Classes="gameList" SelectionMode="Single"
                 ItemsSource="{Binding FilteredGames}" SelectedItem="{Binding SelectedGame, Mode=OneWay}"
                 SelectionChanged="GameList_SelectionChanged"
                 AutomationProperties.Name="Installed games">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="8,8,10,8" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Grid.Column="0" Classes="capsule" VerticalAlignment="Center">
                  <Panel>
                    <TextBlock Text="◆" />
                    <Image Classes="artwork" Opacity="0"
                           gui:ArtworkImage.Kind="Header" gui:ArtworkImage.DecodeWidth="160"
                           gui:ArtworkImage.Game="{Binding}" />
                  </Panel>
                </Border>
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                  <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Name}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                  <Border Grid.Row="1" Grid.Column="0" Classes="providerChip" HorizontalAlignment="Left" Margin="0,4,0,0"
                          ToolTip.Tip="{Binding IdentitySummary}">
                    <TextBlock Text="{Binding IdentitySummary}" />
                  </Border>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ExternalId}" Classes="secondary mono" FontSize="11"
                             Margin="0,4,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>
    <GridSplitter Grid.Column="1" x:Name="SidebarSplitter" ResizeDirection="Columns" Background="Transparent"
                  MinWidth="6" Cursor="SizeWestEast" IsVisible="{Binding ShowLibraryPage}" />
  </Grid>
</UserControl>
