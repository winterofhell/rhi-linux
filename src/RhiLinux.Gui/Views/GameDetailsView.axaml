<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RhiLinux.Gui.Views.GameDetailsView">
  <ScrollViewer x:Name="GameContentScroll" Classes="gameContent pageScroll" Classes.motion="{Binding UseMotion}"
                Classes.loading="{Binding IsSelectionLoading}" IsVisible="{Binding ShowGame}"
                IsHitTestVisible="{Binding ShowGame}" Padding="0,0,4,0">
    <StackPanel Margin="28,28,28,48" Spacing="20" MaxWidth="1080" HorizontalAlignment="Stretch">
      <StackPanel Spacing="8">
        <TextBlock Text="GAME WORKSPACE" Classes="eyebrow" />
        <TextBlock Text="{Binding SelectedGameTitle}" Classes="pageTitle" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="{Binding SelectedGameSubtitle}" Classes="secondary" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Check updates" Classes="compact secondary" Click="CheckForUpdates_Click"
                  IsEnabled="{Binding CanCheckForUpdates}" ToolTip.Tip="Check official sources for newer compatible files" />
        </Grid>
      </StackPanel>

      <Border Classes="warning" IsVisible="{Binding HasRecoveryRequired}">
        <StackPanel Spacing="8">
          <TextBlock Text="Interrupted install detected" Classes="cardTitle" />
          <TextBlock Text="{Binding RecoveryRequiredMessage}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card hero">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding SupportTitle}" Classes="sectionTitle" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SupportMessage}" Classes="secondary" TextWrapping="Wrap" />
          <Border BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,2,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding ExecutableDisplay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ExecutablePath}" />
                <TextBlock Text="{Binding ConfidenceText}" Classes="help" />
              </StackPanel>
              <Button Grid.Column="1" Content="Change target" Classes="quiet compact" Click="ChangeExecutable_Click"
                      AutomationProperties.Name="Change game executable" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="warning" IsVisible="{Binding HasWarnings}">
        <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" />
      </Border>

      <StackPanel Spacing="6">
        <TextBlock Text="Your mod setup" Classes="sectionTitle" />
        <TextBlock Text="Official files, matched to this game. Review each plan before applying changes." Classes="secondary" TextWrapping="Wrap" />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding ComponentCards}" IsEnabled="{Binding CanInteract}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card component" Margin="0,0,0,12">
              <Grid ColumnDefinitions="42,*" ColumnSpacing="14">
                <Border Classes="componentIcon" VerticalAlignment="Top">
                  <TextBlock Text="{Binding Initials}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="12">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Name}" Classes="cardTitle" />
                      <TextBlock Text="{Binding Purpose}" Classes="help" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="statusBadge" Classes.installed="{Binding IsHealthy}"
                            Classes.update="{Binding HasUpdate}" Classes.repair="{Binding NeedsRepair}"
                            Classes.blocked="{Binding IsBlocked}" VerticalAlignment="Top" MaxWidth="180">
                      <TextBlock Text="{Binding State}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Classes="secondary" />
                  <WrapPanel>
                    <TextBlock Text="{Binding InstalledVersion, StringFormat='Installed  {0}'}" Classes="help" Margin="0,0,20,4" />
                    <TextBlock Text="{Binding AvailableVersion, StringFormat='Available  {0}'}" Classes="help" Margin="0,0,20,4" />
                  </WrapPanel>
                  <WrapPanel Classes="button-row">
                    <Button Content="{Binding ActionText}" IsVisible="{Binding CanAct}" Classes="compact primary button-row-item"
                            Click="ComponentAction_Click" ToolTip.Tip="Review and confirm this component action" />
                    <Button Content="{Binding RemoveActionText}" IsVisible="{Binding ShowRemoveAction}"
                            Classes="compact secondary button-row-item" Click="ComponentRemove_Click" />
                    <Button Content="{Binding SecondaryActionText}" IsVisible="{Binding ShowSecondaryAction}"
                            Classes="compact quiet button-row-item" Click="ComponentSecondary_Click" />
                    <Button Content="{Binding OfficialPageActionText}" IsVisible="{Binding CanOpenOfficialPage}"
                            Classes="compact secondary button-row-item" Click="OpenOfficialPage_Click" />
                    <Button Content="Use downloaded addon" IsVisible="{Binding CanUseDownloadedArtifact}"
                            Classes="compact primary button-row-item" Click="UseLocalArtifact_Click" />
                    <TextBlock Text="Ready to play" IsVisible="{Binding NoActionNeeded}" Classes="help"
                               Foreground="{DynamicResource SuccessTextBrush}" VerticalAlignment="Center" Margin="0,0,8,8" />
                  </WrapPanel>
                  <Expander Classes="compact" Header="Advanced details" IsExpanded="{Binding IsDetailsExpanded, Mode=TwoWay}">
                    <StackPanel Spacing="8" Margin="0,12,0,0">
                      <TextBlock Text="{Binding Ownership}" Classes="help" />
                      <TextBlock Text="{Binding SourceProfile}" Classes="help" />
                      <TextBlock Text="{Binding CompatibilityNote}" IsVisible="{Binding HasCompatibilityNote}" Classes="help" />
                      <TextBlock Text="{Binding TechnicalExplanation}" Classes="help" />
                      <TextBlock Text="{Binding Files}" Classes="path secondary" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Hash, StringFormat='SHA-256: {0}'}" IsVisible="{Binding HasHash}" Classes="path help" />
                      <TextBlock Text="{Binding CachePath, StringFormat='Cache: {0}'}" IsVisible="{Binding HasCachePath}" Classes="path help" />
                      <TextBlock Text="{Binding DisabledReason}" IsVisible="{Binding HasDisabledReason}" Classes="help" />
                      <Button Content="Use local artifact" Classes="compact secondary" HorizontalAlignment="Left"
                              Click="UseLocalArtifact_Click" ToolTip.Tip="Choose a local file from the official source for troubleshooting" />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="card hero" IsVisible="{Binding HasLaunchOption}">
        <StackPanel Spacing="12">
          <TextBlock Text="Finish in Steam" Classes="sectionTitle" />
          <TextBlock Text="Open this game's Properties in Steam and paste this into Launch Options." Classes="secondary" TextWrapping="Wrap" />
          <TextBlock Text="{Binding LaunchOptionDescription}" Classes="help" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox x:Name="LaunchOptionBox" Text="{Binding LaunchOption}" IsReadOnly="True" FontFamily="monospace"
                     AutomationProperties.Name="Steam launch option" />
            <Button Grid.Column="1" x:Name="CopyLaunchButton" Content="Copy" Classes="primary" Click="CopyLaunch_Click" />
          </Grid>
          <TextBlock x:Name="CopyFeedback" Text="Copied to clipboard" Foreground="{DynamicResource SuccessTextBrush}" IsVisible="False" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding CanConfigureOptiScaler}">
        <StackPanel Spacing="10">
          <TextBlock Text="Upscaling and frame generation" Classes="sectionTitle" />
          <TextBlock Text="Choose FSR or XeSS backends and configure FSR frame generation for your AMD GPU." Classes="secondary" TextWrapping="Wrap" />
          <Button Content="Configure OptiScaler" Classes="secondary" HorizontalAlignment="Left" Click="ConfigureOptiScaler_Click" />
        </StackPanel>
      </Border>
      <Border Classes="card" IsVisible="{Binding CanConfigureReShade}">
        <StackPanel Spacing="10">
          <TextBlock Text="ReShade presets" Classes="sectionTitle" />
          <TextBlock Text="Import your own preset or disable ordinary shader effects while keeping RenoDX active. Your previous preset is backed up." Classes="secondary" TextWrapping="Wrap" />
          <WrapPanel Classes="button-row">
            <Button Content="Import preset" Classes="secondary button-row-item" Click="ImportPreset_Click" />
            <Button Content="Reset effects" Classes="quiet button-row-item" Click="ResetPreset_Click" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <Expander x:Name="AdvancedGameDetails" Header="Game paths and detection" Classes="compact">
        <Border Classes="card" Margin="0,10,0,0">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
              <TextBlock Text="Windows executable" Classes="eyebrow" />
              <TextBlock Grid.Row="1" Text="{Binding ExecutableDisplay}" Classes="path" ToolTip.Tip="{Binding ExecutablePath}" />
              <Button Grid.RowSpan="2" Grid.Column="1" Content="Open folder" Classes="quiet compact" Click="OpenExecutableFolder_Click" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
              <TextBlock Text="Deployment directory" Classes="eyebrow" />
              <TextBlock Grid.Row="1" Text="{Binding DeploymentDisplay}" Classes="path" ToolTip.Tip="{Binding DeploymentPath}" />
              <Button Grid.RowSpan="2" Grid.Column="1" Content="Change" Classes="quiet compact" Click="ChangeDeploymentFolder_Click" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
              <TextBlock Text="Proton prefix" Classes="eyebrow" />
              <TextBlock Grid.Row="1" Text="{Binding ProtonPrefixDisplay}" Classes="path" ToolTip.Tip="{Binding ProtonPrefixPath}" />
              <Button Grid.RowSpan="2" Grid.Column="1" Content="Change" Classes="quiet compact" Click="ChangePrefixFolder_Click" />
            </Grid>
            <TextBlock Text="{Binding SelectionReason}" Classes="help" />
            <TextBlock Text="{Binding SelectedGame.SteamAppId, StringFormat='Steam AppID  {0}'}" Classes="help" FontFamily="monospace" />
            <Button Content="Reset detection overrides" Classes="quiet compact" HorizontalAlignment="Left" Click="ResetOverrides_Click" />
          </StackPanel>
        </Border>
      </Expander>
      <Expander x:Name="CompatibilityDetails" Header="Compatibility details" Classes="compact">
        <Border Classes="card subtle" Margin="0,10,0,0">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding ProfileSummary}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedProxy, StringFormat='Compatibility filename  {0}'}" Classes="path" />
            <TextBlock Text="{Binding DependencySummary}" Classes="help" />
            <TextBlock Text="{Binding TimingDiagnostics}" IsVisible="{Binding HasTimingDiagnostics}" Classes="help" />
          </StackPanel>
        </Border>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
