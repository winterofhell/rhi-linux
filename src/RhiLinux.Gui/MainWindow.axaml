<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:RhiLinux.Core"
        x:Class="RhiLinux.Gui.MainWindow"
        Title="RHI Linux"
        Width="1360" Height="820"
        MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Classes.motion="{Binding UseMotion}"
        KeyDown="Window_KeyDown">
  <Grid RowDefinitions="Auto,*">
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid ColumnDefinitions="Auto,16,*,Auto,12,Auto,8,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource SystemAccentColor}">
            <TextBlock Text="R" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="RHI Linux" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBox Grid.Column="2" x:Name="SearchBox" Classes="search" Watermark="Search games, AppID, or engine" MaxWidth="520"
                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Search installed games" />
        <TextBlock Grid.Column="3" Text="{Binding GlobalStatus}" Classes="secondary"
                   MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0"
                   ToolTip.Tip="{Binding GlobalStatus}" />
        <ComboBox Grid.Column="5" x:Name="ThemeSelector" MinWidth="108" SelectionChanged="ThemeSelector_SelectionChanged"
                  AutomationProperties.Name="Application theme" ToolTip.Tip="Follow the system theme or choose a light or dark appearance">
          <ComboBoxItem Content="System" />
          <ComboBoxItem Content="Light" />
          <ComboBoxItem Content="Dark" />
        </ComboBox>
        <Button Grid.Column="7" Classes="secondary" Width="36" Height="36" Padding="0" Click="Refresh_Click" IsEnabled="{Binding CanInteract}"
                AutomationProperties.Name="Refresh game libraries" ToolTip.Tip="Rescan configured game sources without losing the selected game">
          <TextBlock Text="↻" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                     TextAlignment="Center" />
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Row="1" x:Name="WorkspaceGrid" ColumnDefinitions="148,320,6,*">
      <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0">
        <ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                 Margin="8,12" Classes="mainNavigation" AutomationProperties.Name="Primary navigation">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Classes="navLabel" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="0,0,1,0"
              IsVisible="{Binding ShowLibraryPage}">
        <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="12,12,8,12">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="8,4,8,8">
            <TextBlock Text="Games" Classes="sectionTitle" VerticalAlignment="Center" />
            <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="8,3"
                    Margin="8,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding FilteredGameCount}" Classes="secondary" FontSize="12" />
            </Border>
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding LibraryFilters}" SelectedItem="{Binding LibraryFilter, Mode=TwoWay}"
                   Margin="4,0,4,8" Classes="filterChips" MaxHeight="140"
                   AutomationProperties.Name="Library filters">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Classes="filterChipLabel" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="2" IsVisible="{Binding ShowNoMatches}" Text="No games match this search."
                     Classes="secondary" TextWrapping="Wrap" Margin="8,0,16,12" />
          <ListBox Grid.Row="3" x:Name="GameList" Classes="gameList"
                   ItemsSource="{Binding FilteredGames}" SelectedItem="{Binding SelectedGame, Mode=OneWay}"
                   SelectionChanged="GameList_SelectionChanged"
                   AutomationProperties.Name="Installed games">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="12,10,12,10" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Name}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding IdentitySummary}" Classes="secondary" FontSize="12"
                             TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip.Tip="{Binding IdentitySummary}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ExternalId}" Classes="secondary" FontSize="12"
                             Margin="0,4,0,0" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="2" x:Name="SidebarSplitter" ResizeDirection="Columns" Background="Transparent"
                    MinWidth="6" Cursor="SizeWestEast" IsVisible="{Binding ShowLibraryPage}" />

      <Grid Grid.Column="3">
        <ScrollViewer IsVisible="{Binding ShowOverviewPage}" Padding="24,20,28,32"
                      HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="{Binding ShowOverviewPage}">
          <StackPanel Spacing="16" MaxWidth="920">
            <TextBlock Text="Overview" Classes="pageTitle" />
            <TextBlock Text="{Binding OverviewSummary}" Classes="secondary" TextWrapping="Wrap" />

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="Library summary" Classes="sectionTitle" />
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding OverviewReadyCount}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Ready games" Classes="secondary" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding OverviewNeedsAttentionCount}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Need attention" Classes="secondary" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="{Binding OverviewUnsupportedReadinessCount}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Unsupported" Classes="secondary" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Spacing="2">
                    <TextBlock Text="{Binding OverviewUpdateCount}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Component updates" Classes="secondary" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding OverviewRecoveryCount}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Recoveries required" Classes="secondary" />
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2">
                    <TextBlock Text="{Binding OverviewEnabledSourceCount}" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Enabled sources" Classes="secondary" />
                  </StackPanel>
                  <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding OverviewAttentionSummary}"
                             Classes="secondary" TextWrapping="Wrap" />
                </Grid>
                <WrapPanel Orientation="Horizontal" Classes="button-row">
                  <Button Content="Open ready games" Classes="compact secondary button-row-item"
                          Click="OpenReadyGames_Click" />
                  <Button Content="Review issues" Classes="compact secondary button-row-item"
                          Click="OpenNeedsAttention_Click" />
                  <Button Content="Review updates" Classes="compact secondary button-row-item"
                          Click="OpenUpdates_Click" />
                  <Button Content="Open recovery items" Classes="compact secondary button-row-item"
                          Click="OpenRecoveryItems_Click" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="Source status" Classes="sectionTitle" />
                <TextBlock Text="{Binding OverviewSourceSummary}" Classes="secondary" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ScanMetricsText}" Classes="secondary" TextWrapping="Wrap"
                           IsVisible="{Binding HasScanMetrics}" />
                <TextBlock Text="{Binding CapabilityPreflightText}" Classes="secondary" TextWrapping="Wrap"
                           IsVisible="{Binding HasCapabilityPreflight}" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="Components and updates" Classes="sectionTitle" />
                <TextBlock Text="{Binding OverviewUpdateSummary}" Classes="secondary" TextWrapping="Wrap" />
                <Button Content="Open Updates" Classes="compact secondary" HorizontalAlignment="Left"
                        Click="OpenUpdates_Click" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="Recent diagnostics" Classes="sectionTitle" />
                <TextBlock Text="{Binding OverviewDiagnosticSummary}" Classes="secondary" TextWrapping="Wrap" />
                <Button Content="Open Diagnostics" Classes="compact secondary" HorizontalAlignment="Left"
                        Click="OpenDiagnostics_Click" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding ShowUpdatesPage}" Padding="24,20,28,32"
                      HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="{Binding ShowUpdatesPage}">
          <StackPanel Spacing="16" MaxWidth="920">
            <DockPanel LastChildFill="True">
              <Button DockPanel.Dock="Right" Content="Check for updates" Classes="compact secondary"
                      Margin="12,0,0,0" VerticalAlignment="Top"
                      IsEnabled="{Binding CanCheckForUpdates}" Click="CheckForUpdates_Click"
                      ToolTip.Tip="Check official sources for the selected game" />
              <StackPanel Spacing="4">
                <TextBlock Text="Updates" Classes="pageTitle" />
                <TextBlock Text="Component updates are checked per selected game using official sources."
                           Classes="secondary" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>

            <Border Classes="emptyState" IsVisible="{Binding UpdatesIsLoading}">
              <StackPanel Spacing="12" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="3" />
                <TextBlock Text="Checking for updates" Classes="sectionTitle" HorizontalAlignment="Center" />
                <TextBlock Text="Querying official component sources for the selected game."
                           Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding UpdatesHasAvailable}">
              <StackPanel Spacing="12">
                <TextBlock Text="Available updates" Classes="sectionTitle" />
                <TextBlock Text="{Binding UpdateStatusText}" Classes="secondary" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding ComponentUpdates}" IsVisible="{Binding HasComponentUpdates}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="card subtle" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="6">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding GameName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ComponentName}" />
                            <TextBlock Text="{Binding InstalledVersion, StringFormat='Installed: {0}'}" Classes="secondary" FontSize="12" />
                            <TextBlock Text="{Binding AvailableVersion, StringFormat='Available: {0}'}" Classes="secondary" FontSize="12" />
                            <TextBlock Text="{Binding ReadinessImpact, StringFormat='Readiness: {0}'}" Classes="secondary" FontSize="12" />
                          </StackPanel>
                          <Border Grid.Column="1" Classes="statusBadge update" VerticalAlignment="Top">
                            <TextBlock Text="{Binding UpdateState}" FontWeight="SemiBold" />
                          </Border>
                          <Button Grid.Row="1" Grid.ColumnSpan="2" Content="Review update" Classes="compact secondary"
                                  HorizontalAlignment="Left" IsVisible="{Binding CanReview}"
                                  Click="ReviewComponentUpdate_Click"
                                  Tag="{Binding InstallId}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding OutdatedComponents}" IsVisible="{Binding !HasComponentUpdates}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="card subtle" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                          <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Explanation}" Classes="secondary" TextWrapping="Wrap" />
                          </StackPanel>
                          <Border Grid.Column="1" Classes="statusBadge update">
                            <TextBlock Text="{Binding State}" FontWeight="SemiBold" />
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="emptyState" IsVisible="{Binding UpdatesIsEmpty}">
              <StackPanel Spacing="8" HorizontalAlignment="Center" MaxWidth="420">
                <TextBlock Text="No updates available" Classes="sectionTitle" HorizontalAlignment="Center" />
                <TextBlock Text="Installed components are up to date."
                           Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" />
              </StackPanel>
            </Border>

            <Border Classes="emptyState" IsVisible="{Binding UpdatesIsOffline}">
              <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="420">
                <TextBlock Text="Update sources unavailable" Classes="sectionTitle" HorizontalAlignment="Center" />
                <TextBlock Text="Could not reach official component sources. Check your network connection and try again."
                           Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" />
                <Button Content="Retry" Classes="primary" HorizontalAlignment="Center"
                        IsEnabled="{Binding CanCheckForUpdates}" Click="CheckForUpdates_Click" />
              </StackPanel>
            </Border>

            <Border Classes="emptyState" IsVisible="{Binding UpdatesIsUnavailable}">
              <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="420">
                <TextBlock Text="Unable to check for updates" Classes="sectionTitle" HorizontalAlignment="Center" />
                <TextBlock Text="Select a game in Library, then check official sources again."
                           Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" />
                <Button Content="Open Library" Classes="compact secondary" HorizontalAlignment="Center"
                        Click="OpenLibrary_Click" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding ShowDiagnosticsPage}" Padding="24,20,28,32"
                      HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="{Binding ShowDiagnosticsPage}">
          <StackPanel Spacing="16" MaxWidth="960">
            <TextBlock Text="Diagnostics" Classes="pageTitle" />
            <TextBlock Text="{Binding LastScanSummary}" Classes="secondary" TextWrapping="Wrap" />

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="Runtime" Classes="sectionTitle" />
                <TextBlock Text="{Binding ProtonSummary}" Classes="secondary" TextWrapping="Wrap" />
                <TextBlock Text="{Binding HdrSummary}" Classes="secondary" TextWrapping="Wrap" />
                <TextBlock Text="Suggested launch composition" Classes="secondary" Margin="0,4,0,0" />
                <TextBox Text="{Binding LaunchCompositionText}" IsReadOnly="True" TextWrapping="Wrap"
                         AutomationProperties.Name="Suggested launch composition" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Source providers" Classes="sectionTitle" />
                <TextBlock IsVisible="{Binding !HasProviderStatuses}" Text="Provider details appear after the next library scan."
                           Classes="secondary" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding ProviderStatuses}" IsVisible="{Binding HasProviderStatuses}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="card subtle" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding Status}" Classes="secondary" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RootPath}" Classes="path secondary" TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding HasRootPath}" ToolTip.Tip="{Binding RootPath}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                            <Border Classes="statusBadge">
                              <TextBlock Text="{Binding EnabledLabel}" FontSize="12" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding DetectionLabel}" Classes="secondary" FontSize="12"
                                       HorizontalAlignment="Right" />
                          </StackPanel>
                          <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                                     Text="{Binding GameCount, StringFormat='Games discovered: {0}'}"
                                     Classes="secondary" FontSize="12" />
                          <TextBlock Grid.Row="2" Grid.ColumnSpan="3"
                                     Text="{Binding RootCount, StringFormat='Roots: {0}'}"
                                     Classes="secondary" FontSize="12" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Source diagnostics" Classes="sectionTitle" />
                <Border Classes="emptyState" IsVisible="{Binding !HasDiagnosticItems}" Padding="20,24">
                  <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="No diagnostics" Classes="sectionTitle" HorizontalAlignment="Center" />
                    <TextBlock Text="Source scans have not reported warnings or errors."
                               Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" />
                  </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding DiagnosticItems}" IsVisible="{Binding HasDiagnosticItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="card subtle" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                          <Border Classes="severityBadge" Classes.warning="{Binding IsWarning}"
                                  Classes.error="{Binding IsError}" Classes.info="{Binding IsInfo}">
                            <TextBlock Text="{Binding Severity}" FontSize="12" FontWeight="SemiBold" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Provider, StringFormat='Provider: {0}'}" Classes="secondary" FontSize="12" />
                            <TextBlock Text="{Binding Code, StringFormat='Code: {0}'}" Classes="secondary" FontSize="12" />
                          </StackPanel>
                          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Path}" Classes="path secondary"
                                     TextTrimming="CharacterEllipsis" IsVisible="{Binding HasPath}"
                                     ToolTip.Tip="{Binding Path}" />
                          <TextBox Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Detail}" IsReadOnly="True"
                                   TextWrapping="Wrap" IsVisible="{Binding HasDetail}"
                                   AutomationProperties.Name="Diagnostic detail" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding ShowSettingsPage}" Padding="24,20,28,32"
                      HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="{Binding ShowSettingsPage}">
          <StackPanel Spacing="16" MaxWidth="920">
            <TextBlock Text="Settings" Classes="pageTitle" />
            <TextBlock Text="Configure game sources, download cache, and appearance-related preferences."
                       Classes="secondary" TextWrapping="Wrap" />

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Game sources" Classes="sectionTitle" />
                <CheckBox Content="Scan all configured sources" IsChecked="{Binding ScanAllSources, Mode=TwoWay}"
                          ToolTip.Tip="Discover Steam, Heroic, Legendary, Lutris, Bottles, Minigalaxy, and manual installations" />
                <TextBlock Classes="help" Text="Steam remains available when multi-source scanning is disabled. Other providers are skipped until enabled again." />
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                  <TextBlock Text="Steam" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Always enabled" Classes="secondary" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Text="Heroic" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="1" Grid.Column="1" Content="Enabled" IsChecked="{Binding EnableHeroic, Mode=TwoWay}" />
                  <TextBlock Grid.Row="2" Text="Legendary" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="2" Grid.Column="1" Content="Enabled" IsChecked="{Binding EnableLegendary, Mode=TwoWay}" />
                  <TextBlock Grid.Row="3" Text="Lutris" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="3" Grid.Column="1" Content="Enabled" IsChecked="{Binding EnableLutris, Mode=TwoWay}" />
                  <TextBlock Grid.Row="4" Text="Bottles" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="4" Grid.Column="1" Content="Enabled" IsChecked="{Binding EnableBottles, Mode=TwoWay}" />
                  <TextBlock Grid.Row="5" Text="Minigalaxy" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <CheckBox Grid.Row="5" Grid.Column="1" Content="Enabled" IsChecked="{Binding EnableMinigalaxy, Mode=TwoWay}" />
                  <TextBlock Grid.Row="6" Text="Manual" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="6" Grid.Column="1" Text="Always enabled when multi-source scanning is on" Classes="secondary" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Additional Steam library" Classes="secondary" Margin="0,4,0,0" />
                <TextBox Text="{Binding AdditionalSteamLibrary, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         Watermark="/path/to/additional/steamapps parent"
                         ToolTip.Tip="Use this only when Steam libraries are stored outside automatically detected locations." />
                <TextBlock Classes="help" Text="Changing providers or custom roots saves preferences and schedules a targeted library refresh." />
                <Button Content="Rescan sources now" Classes="compact secondary" HorizontalAlignment="Left"
                        IsEnabled="{Binding CanInteract}" Click="Refresh_Click"
                        ToolTip.Tip="Rescan configured game sources immediately" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Download cache" Classes="sectionTitle" />
                <TextBlock Classes="help"
                           Text="Cache limit is the maximum disk space used for downloaded ReShade, RenoDX, and OptiScaler files. Files required by installed games are never removed automatically." />
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                  <TextBlock Text="Current size" Classes="secondary" />
                  <TextBlock Grid.Column="1" Text="{Binding CacheSizeText}" />
                  <TextBlock Grid.Row="1" Text="Last cleanup" Classes="secondary" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CacheCleanupText}" />
                  <TextBlock Grid.Row="2" Text="Size limit" Classes="secondary" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Row="2" Grid.Column="1" Width="140" HorizontalAlignment="Left"
                                 Minimum="0.0009765625" Maximum="2097151" Increment="0.25" FormatString="0.## GiB"
                                 Value="{Binding CacheLimitGiB, Mode=TwoWay}" />
                </Grid>
                <TextBlock Text="Archive capabilities" Classes="secondary" />
                <TextBlock Text="{Binding CapabilityPreflightText}" Classes="help path" TextWrapping="Wrap"
                           IsVisible="{Binding HasCapabilityPreflight}" />
                <WrapPanel Orientation="Horizontal" Classes="button-row">
                  <Button Content="Clear unused files" Classes="compact secondary button-row-item"
                          IsEnabled="{Binding CanManageCache}" Click="ClearCache_Click"
                          ToolTip.Tip="Remove unused cached downloads while keeping files still referenced by installed games" />
                  <Button Content="Verify cache" Classes="compact secondary button-row-item"
                          IsEnabled="{Binding CanManageCache}" Click="VerifyCache_Click"
                          ToolTip.Tip="Check cached downloads for damage without modifying game files" />
                  <Button Content="Open cache folder" Classes="compact secondary button-row-item"
                          IsEnabled="{Binding CanManageCache}" Click="OpenCacheFolder_Click"
                          ToolTip.Tip="Open the download cache directory in the file manager" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Readiness" Classes="sectionTitle" />
                <CheckBox Content="Automatically evaluate readiness after library refresh"
                          IsChecked="{Binding AutomaticallyEvaluateReadiness, Mode=TwoWay}"
                          ToolTip.Tip="Evaluate the selected game after discovery without downloading files" />
                <CheckBox Content="Show unsupported native games"
                          IsChecked="{Binding ShowUnsupportedNativeGames, Mode=TwoWay}"
                          ToolTip.Tip="Keep native Linux installs visible in the library list" />
                <CheckBox Content="Warn before anti-cheat deployments"
                          IsChecked="{Binding WarnBeforeAntiCheatDeployments, Mode=TwoWay}"
                          ToolTip.Tip="Treat anti-cheat detections as blocking readiness issues" />
                <CheckBox Content="Prefer existing managed component versions"
                          IsChecked="{Binding PreferExistingManagedVersions, Mode=TwoWay}"
                          ToolTip.Tip="Recommend keeping current managed installs when they are healthy" />
                <CheckBox Content="Refresh artifact metadata on startup"
                          IsChecked="{Binding RefreshArtifactMetadataOnStartup, Mode=TwoWay}"
                          ToolTip.Tip="Allow automatic official source checks after selecting a game at startup" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Updates and discovery" Classes="sectionTitle" />
                <CheckBox Content="Check for updates automatically"
                          IsChecked="{Binding CheckForUpdatesAutomatically, Mode=TwoWay}"
                          ToolTip.Tip="Checks official component sources after selecting a game. It does not modify game files." />
                <TextBlock Classes="help" Text="Checks official component sources after startup selection. It does not modify game files." />
                <Button Content="Refresh RenoDX catalog" Classes="compact secondary" HorizontalAlignment="Left"
                        IsEnabled="{Binding CanManageCache}" Click="RefreshRenoDxCatalog_Click"
                        ToolTip.Tip="Reload the official RenoDX Mods wiki catalog and refresh the selected game." />
                <CheckBox Content="Reduce non-essential motion" IsChecked="{Binding ReduceMotion, Mode=TwoWay}"
                          ToolTip.Tip="Disable fades and other decorative transitions" />
                <Button Content="Reset settings to defaults" Classes="compact secondary" HorizontalAlignment="Left"
                        Click="ResetSettings_Click"
                        ToolTip.Tip="Restore cache limit, motion, update checks, and source defaults" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="GameContentScroll" Classes="gameContent" Classes.motion="{Binding UseMotion}"
                      Classes.loading="{Binding IsSelectionLoading}"
                      IsVisible="{Binding ShowGame}" HorizontalScrollBarVisibility="Disabled"
                      IsHitTestVisible="{Binding ShowGame}"
                      Padding="0,0,4,0">
          <StackPanel Margin="24,20,28,32" Spacing="16" MaxWidth="1400" HorizontalAlignment="Stretch">
            <DockPanel LastChildFill="True">
              <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                         VerticalAlignment="Top" Margin="16,0,0,8" MaxWidth="420" Classes="button-row">
                <Button Classes="compact primary button-row-item" MinWidth="108" Click="InstallRecommended_Click"
                        IsEnabled="{Binding CanInstallRecommendedStack}" Content="{Binding PrimaryActionText}"
                        ToolTip.Tip="Review and confirm the recommended action for this game" />
                <Button Classes="compact secondary button-row-item" Click="CheckForUpdates_Click" IsEnabled="{Binding CanCheckForUpdates}"
                        ToolTip.Tip="Check official sources for newer compatible files">Check for updates</Button>
                <Button Classes="compact secondary button-row-item" Click="Restore_Click"
                        ToolTip.Tip="Review recoverable backups for this game">Restore backups</Button>
              </WrapPanel>
              <StackPanel Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="{Binding SelectedGameTitle}" Classes="pageTitle"
                           TextWrapping="Wrap" ToolTip.Tip="{Binding SelectedGameTitle}" />
                <TextBlock Text="{Binding SelectedGameSubtitle}" Classes="secondary" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <DockPanel LastChildFill="True">
                  <Button DockPanel.Dock="Right" Content="Refresh readiness" Classes="compact secondary"
                          Margin="12,0,0,0" Click="RefreshReadiness_Click"
                          AutomationProperties.Name="Refresh readiness" />
                  <StackPanel Spacing="4">
                    <TextBlock Text="Game Readiness Center" Classes="sectionTitle" />
                    <TextBlock Text="{Binding Readiness.IssueCountsText}" Classes="secondary" />
                  </StackPanel>
                </DockPanel>
                <Border Classes="emptyState" IsVisible="{Binding Readiness.ShowLoading}" Padding="16,20">
                  <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="3" />
                    <TextBlock Text="Evaluating readiness…" Classes="secondary" />
                  </StackPanel>
                </Border>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding Readiness.HasResult}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Readiness.StateLabel}" Classes="sectionTitle" />
                    <TextBlock Text="{Binding Readiness.Summary}" Classes="secondary" TextWrapping="Wrap" MaxWidth="780" />
                    <TextBlock Text="{Binding Readiness.NextAction, StringFormat='Next action: {0}'}" FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6">
                    <Border Classes="statusBadge installed" IsVisible="{Binding Readiness.ShowReadyBadge}">
                      <TextBlock Text="{Binding Readiness.StateLabel}" FontWeight="SemiBold" />
                    </Border>
                    <Border Classes="statusBadge repair" IsVisible="{Binding Readiness.ShowNeedsAttentionBadge}">
                      <TextBlock Text="{Binding Readiness.StateLabel}" FontWeight="SemiBold" />
                    </Border>
                    <Border Classes="statusBadge blocked" IsVisible="{Binding Readiness.ShowUnsupportedBadge}">
                      <TextBlock Text="{Binding Readiness.StateLabel}" FontWeight="SemiBold" />
                    </Border>
                    <Border Classes="statusBadge" IsVisible="{Binding ShowUpdateStatusChip}">
                      <TextBlock Text="{Binding UpdateStatusText}" FontWeight="SemiBold" />
                    </Border>
                  </StackPanel>
                </Grid>
                <WrapPanel Orientation="Horizontal" Classes="button-row" IsVisible="{Binding Readiness.HasResult}">
                  <Button Content="Review recommended setup" Classes="compact primary button-row-item"
                          Click="InstallRecommended_Click" IsEnabled="{Binding CanInstallRecommendedStack}" />
                  <Button Content="Copy launch configuration" Classes="compact secondary button-row-item"
                          Click="CopyReadinessLaunch_Click" IsEnabled="{Binding Readiness.CanCopyLaunchConfiguration}" />
                  <Button Content="Choose executable" Classes="compact secondary button-row-item"
                          Click="ChangeExecutable_Click" />
                  <Button Content="Open diagnostics" Classes="compact secondary button-row-item"
                          Click="OpenDiagnostics_Click" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding Readiness.HasResult}">
              <StackPanel Spacing="10">
                <TextBlock Text="Game target" Classes="sectionTitle" />
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                  <TextBlock Text="Executable" Classes="secondary" />
                  <TextBlock Grid.Column="1" Text="{Binding Readiness.ExecutableDisplay}" FontWeight="SemiBold"
                             ToolTip.Tip="{Binding Readiness.ExecutablePath}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Row="1" Text="Deployment directory" Classes="secondary" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Readiness.DeploymentDirectoryDisplay}"
                             Classes="path" ToolTip.Tip="{Binding Readiness.DeploymentDirectoryDisplay}" />
                  <TextBlock Grid.Row="2" Text="Prefix" Classes="secondary" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Readiness.PrefixDisplay}" Classes="path"
                             ToolTip.Tip="{Binding Readiness.PrefixDisplay}" />
                  <TextBlock Grid.Row="3" Text="Launcher" Classes="secondary" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Readiness.LauncherDisplay}" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding Readiness.HasLaunchConfiguration}">
              <StackPanel Spacing="10">
                <TextBlock Text="Launch configuration" Classes="sectionTitle" />
                <TextBlock Text="{Binding Readiness.LaunchInstructions}" Classes="secondary" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Readiness.LaunchExplanation}" Classes="secondary" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding Readiness.LaunchValue}" IsReadOnly="True" TextWrapping="Wrap"
                           FontFamily="monospace" AutomationProperties.Name="Required launch configuration" />
                  <Button Grid.Column="1" Content="Copy" Classes="primary" Click="CopyReadinessLaunch_Click"
                          IsEnabled="{Binding Readiness.CanCopyLaunchConfiguration}" />
                </Grid>
                <TextBlock Text="{Binding Readiness.LastCopiedFeedback}"
                           Foreground="{DynamicResource SuccessTextBrush}"
                           IsVisible="{Binding Readiness.ShowCopiedFeedback}" />
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding Readiness.HasSetupOptions}">
              <StackPanel Spacing="10">
                <TextBlock Text="Recommended setup" Classes="sectionTitle" />
                <TextBlock Text="{Binding Readiness.SetupSummary}" Classes="secondary" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Readiness.SetupOptions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="card subtle" Margin="0,0,0,8" Opacity="{Binding SupportOpacity}">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Explanation}" Classes="secondary" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding UnsupportedReason}" Classes="secondary" TextWrapping="Wrap"
                                     IsVisible="{Binding HasUnsupportedReason}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding Readiness.HasPlanSummary}">
              <StackPanel Spacing="10">
                <TextBlock Text="Recommended plan" Classes="sectionTitle" />
                <ItemsControl ItemsSource="{Binding Readiness.PlanHighlights}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" Classes="secondary" Margin="0,0,0,4" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Review deployment plan" Classes="compact secondary" HorizontalAlignment="Left"
                        Click="InstallRecommended_Click" IsEnabled="{Binding CanInstallRecommendedStack}" />
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding Readiness.HasIssues}">
              <StackPanel Spacing="10">
                <TextBlock Text="Issues" Classes="sectionTitle" />
                <ItemsControl ItemsSource="{Binding Readiness.Issues}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="card subtle" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                          <Border Classes="severityBadge" Classes.warning="{Binding IsWarning}"
                                  Classes.error="{Binding IsBlocking}">
                            <TextBlock Text="{Binding Severity}" FontSize="12" FontWeight="SemiBold" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Message}" Classes="secondary" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Code}" Classes="secondary" FontSize="12" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="warning" IsVisible="{Binding HasWarnings}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <TextBlock Text="!" FontSize="18" FontWeight="Bold" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding WarningText}" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Expander x:Name="CompatibilityDetails" Header="Advanced compatibility details" Classes="compact">
              <Border Classes="card subtle" Margin="0,8,0,0">
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                  <TextBlock Text="Game profile" Classes="secondary" />
                  <TextBlock Grid.Column="1" Text="{Binding ProfileSummary}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1" Text="Compatibility filename" Classes="secondary" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProxy}" FontFamily="monospace" />
                  <TextBlock Grid.Row="2" Text="Dependencies" Classes="secondary" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DependencySummary}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="3" Text="Timing" Classes="secondary" IsVisible="{Binding HasTimingDiagnostics}" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TimingDiagnostics}" Classes="secondary"
                             TextWrapping="Wrap" IsVisible="{Binding HasTimingDiagnostics}" />
                </Grid>
              </Border>
            </Expander>

            <Expander x:Name="AdvancedGameDetails" Header="Advanced game details" Classes="compact">
              <Border Classes="card" Margin="0,8,0,0">
                <StackPanel Spacing="12">
                  <TextBlock Text="Game setup" Classes="sectionTitle" />
                  <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                    <TextBlock Grid.Row="0" Text="Executable" Classes="secondary" VerticalAlignment="Center" />
                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding ExecutableDisplay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding ExecutablePath}" />
                        <TextBlock Text="{Binding ConfidenceText}" Classes="secondary" FontSize="12"
                                   ToolTip.Tip="Confidence is based on PE architecture, engine layout, filename, size, and helper exclusions." />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="compact quiet" Click="ChangeExecutable_Click"
                              AutomationProperties.Name="Change game executable" ToolTip.Tip="Choose a Windows executable inside this game">Change</Button>
                      <Button Grid.Column="2" Classes="compact quiet" Click="OpenExecutableFolder_Click"
                              ToolTip.Tip="Open the executable folder in the desktop file manager">Open folder</Button>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="Architecture" Classes="secondary" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ArchitectureDisplay}" />
                    <TextBlock Grid.Row="2" Text="Engine" Classes="secondary" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EngineDisplay}" />
                    <TextBlock Grid.Row="3" Text="Game folder" Classes="secondary" VerticalAlignment="Center" />
                    <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding DeploymentDisplay}" Classes="path" VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding DeploymentPath}" />
                      <Button Grid.Column="1" Classes="compact quiet" Click="ChangeDeploymentFolder_Click"
                              ToolTip.Tip="Choose the folder where the game loads compatibility files">Change</Button>
                    </Grid>
                    <TextBlock Grid.Row="4" Text="Why selected" Classes="secondary" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectionReason}" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="5" Text="Proton prefix" Classes="secondary" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ProtonPrefixDisplay}" Classes="path"
                               ToolTip.Tip="{Binding ProtonPrefixPath}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="6" Text="Steam AppID" Classes="secondary" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedGame.SteamAppId}" FontFamily="monospace" />
                  </Grid>
                </StackPanel>
              </Border>
            </Expander>

            <StackPanel Spacing="6">
              <TextBlock Text="Required files" Classes="sectionTitle" />
              <TextBlock Text="RHI Linux picks compatible official files for you. Use Advanced details for individual actions."
                         Classes="secondary" TextWrapping="Wrap" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding ComponentCards}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" ItemWidth="320" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card component" Width="304" Margin="0,0,16,16">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding Name}" Classes="cardTitle" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" Classes="statusBadge">
                          <TextBlock Text="{Binding State}" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                      </Grid>
                      <TextBlock Grid.Row="1" Text="{Binding Explanation}" TextWrapping="Wrap" Classes="secondary"
                                 MinHeight="40" />
                      <TextBlock Grid.Row="2" Text="{Binding Version, StringFormat='Version {0}'}"
                                 IsVisible="{Binding HasVersion}" MinHeight="18" />
                      <WrapPanel Grid.Row="3" Orientation="Horizontal" Classes="button-row">
                        <Button Content="{Binding ActionText}" IsVisible="{Binding CanAct}"
                                Classes="compact primary button-row-item" HorizontalAlignment="Left" MinWidth="96"
                                Click="ComponentAction_Click"
                                ToolTip.Tip="Review and confirm this component action" />
                        <Button Content="{Binding RemoveActionText}" IsVisible="{Binding ShowRemoveAction}"
                                Classes="compact secondary button-row-item" HorizontalAlignment="Left" MinWidth="96"
                                Click="ComponentRemove_Click"
                                ToolTip.Tip="Review and confirm removal of this managed component" />
                        <Button Content="{Binding SecondaryActionText}" IsVisible="{Binding ShowSecondaryAction}"
                                Classes="compact secondary button-row-item" HorizontalAlignment="Left" MinWidth="96"
                                Click="ComponentSecondary_Click"
                                ToolTip.Tip="Inspect detected files or check again without changing them" />
                        <Button Content="Open official page" IsVisible="{Binding CanOpenOfficialPage}"
                                Classes="compact secondary button-row-item" HorizontalAlignment="Left"
                                Click="OpenOfficialPage_Click"
                                ToolTip.Tip="Open the official RenoDX page for this game" />
                        <TextBlock Text="No action needed" IsVisible="{Binding NoActionNeeded}"
                                   Classes="secondary" VerticalAlignment="Center" Margin="0,0,8,8" />
                      </WrapPanel>
                      <Expander Grid.Row="4" Classes="compact" Header="Advanced details"
                                IsExpanded="{Binding IsDetailsExpanded, Mode=TwoWay}">
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                          <TextBlock Text="{Binding SourceProfile}" Classes="secondary" />
                          <TextBlock Text="{Binding CompatibilityNote}" IsVisible="{Binding HasCompatibilityNote}"
                                     Classes="secondary" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding TechnicalExplanation}" Classes="secondary" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Files}" Classes="path secondary" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Hash, StringFormat='SHA-256: {0}'}" IsVisible="{Binding HasHash}"
                                     Classes="path secondary" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding CachePath, StringFormat='Cache: {0}'}" IsVisible="{Binding HasCachePath}"
                                     Classes="path secondary" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding DisabledReason}" IsVisible="{Binding HasDisabledReason}"
                                     TextWrapping="Wrap" Classes="secondary" ToolTip.Tip="{Binding DisabledReason}" />
                          <Expander Header="Advanced troubleshooting" Classes="compact" Margin="0,4,0,0">
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                              <TextBlock Text="Use a local file only when automatic download support has failed and you know the file is from the official source."
                                         Classes="secondary" TextWrapping="Wrap" />
                              <Button Content="Use local artifact" Classes="compact secondary" HorizontalAlignment="Left"
                                      Click="UseLocalArtifact_Click"
                                      ToolTip.Tip="Troubleshooting feature: select a local component file" />
                            </StackPanel>
                          </Expander>
                        </StackPanel>
                      </Expander>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="card" IsVisible="{Binding ShowHdrGuidance}">
              <StackPanel Spacing="10">
                <TextBlock Text="Enable HDR through Proton" Classes="sectionTitle" />
                <TextBlock Text="These environment variables are for the Linux Proton HDR workflow used by RenoDX. They are not applied automatically unless Steam already contains matching launch options."
                           Classes="secondary" TextWrapping="Wrap" />
                <Border Classes="statusBadge" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding HdrLaunchOptionStatusText}" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="{Binding HdrLaunchOptionExplanation}" Classes="secondary" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasHdrLaunchOption}">
                  <TextBox Grid.Column="0" x:Name="HdrLaunchOptionBox" Text="{Binding HdrLaunchOption}" IsReadOnly="True"
                           FontFamily="monospace" HorizontalContentAlignment="Left"
                           AutomationProperties.Name="Proton HDR launch option" />
                  <Button Grid.Column="1" x:Name="CopyHdrLaunchButton" Classes="primary" Click="CopyHdrLaunch_Click">Copy</Button>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="Steam launch option" Classes="sectionTitle" />
                <TextBlock Text="Copy this value to the game's Steam launch options."
                           Classes="secondary" TextWrapping="Wrap" />
                <Border Classes="statusBadge" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding LaunchOptionStatusText}" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="{Binding LaunchOptionExplanation}" Classes="secondary" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasLaunchOption}">
                  <TextBox Grid.Column="0" x:Name="LaunchOptionBox" Text="{Binding LaunchOption}" IsReadOnly="True"
                           FontFamily="monospace" HorizontalContentAlignment="Left"
                           AutomationProperties.Name="Steam launch option" />
                  <Button Grid.Column="1" x:Name="CopyLaunchButton" Classes="primary" Click="CopyLaunch_Click">Copy</Button>
                </Grid>
                <TextBlock x:Name="CopyFeedback" Text="Copied to clipboard"
                           Foreground="{DynamicResource SuccessTextBrush}" IsVisible="False" />
              </StackPanel>
            </Border>

            <Expander x:Name="AdvancedExecutableDetails" Header="Advanced executable details" Classes="compact">
              <Border Classes="card subtle" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding Candidates}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="56,80,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" Margin="0,6">
                        <TextBlock Text="{Binding Score}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Confidence}" Classes="secondary" />
                        <TextBlock Grid.Column="2" Text="{Binding Path}" Classes="path" ToolTip.Tip="{Binding Path}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Reasons}" Classes="secondary"
                                   FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </Expander>
          </StackPanel>
        </ScrollViewer>

        <Grid IsVisible="{Binding ShowGameLoading}" IsHitTestVisible="False"
              HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="24,20,28,0" MaxWidth="1100">
          <StackPanel Spacing="16">
            <Border Classes="skeleton" Width="280" Height="30" HorizontalAlignment="Left" />
            <Border Classes="skeleton" Width="190" Height="14" HorizontalAlignment="Left" />
            <Border Classes="card skeletonCard">
              <StackPanel Spacing="12">
                <Border Classes="skeleton" Width="220" Height="20" HorizontalAlignment="Left" />
                <Border Classes="skeleton" Height="13" />
                <Border Classes="skeleton" Width="520" MaxWidth="520" Height="13" HorizontalAlignment="Left" />
                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <Border Grid.Column="0" Classes="card skeletonCard" Height="155" />
              <Border Grid.Column="1" Classes="card skeletonCard" Height="155" />
              <Border Grid.Column="2" Classes="card skeletonCard" Height="155" />
            </Grid>
          </StackPanel>
        </Grid>

        <Grid IsVisible="{Binding ShowWelcome}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="32"
              IsHitTestVisible="{Binding ShowWelcome}">
          <StackPanel Spacing="12" HorizontalAlignment="Center">
            <TextBlock Text="Select a game" Classes="pageTitle" HorizontalAlignment="Center" />
            <TextBlock Text="Installed Windows games from Steam and other launchers are discovered automatically. Choose one from the sidebar to get started."
                       Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </Grid>
        <Grid IsVisible="{Binding ShowNoGames}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500" Margin="32"
              IsHitTestVisible="{Binding ShowNoGames}">
          <StackPanel Spacing="12" HorizontalAlignment="Center">
            <TextBlock Text="No compatible games found" Classes="pageTitle" HorizontalAlignment="Center" />
            <TextBlock Text="Check that Steam, Heroic, Lutris, or Bottles has at least one Windows game with a valid executable."
                       Classes="secondary" TextWrapping="Wrap" TextAlignment="Center" />
            <Button Content="Scan again" Classes="primary" HorizontalAlignment="Center" Click="Refresh_Click" />
          </StackPanel>
        </Grid>
        <Border IsVisible="{Binding HasError}" Classes="warning" VerticalAlignment="Bottom" Margin="24">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Dismiss" Classes="compact quiet" Click="DismissError_Click" />
          </Grid>
        </Border>
        <Border IsVisible="{Binding IsBusy}" Background="{DynamicResource OverlayBrush}">
          <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="280">
            <StackPanel Spacing="12">
              <ProgressBar IsIndeterminate="True" />
              <TextBlock Text="{Binding GlobalStatus}" TextAlignment="Center" TextWrapping="Wrap" />
              <Button Content="Cancel" HorizontalAlignment="Center" Classes="compact secondary" Click="Cancel_Click" />
            </StackPanel>
          </Border>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
