#!/bin/sh
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
APP="$HERE/usr/lib/rhi-linux"
if [ "${1-}" = "--cli" ]; then
    shift
    TARGET="$APP/RhiLinux.Cli"
elif [ "${1-}" = "--version" ]; then
    cat "$HERE/usr/share/rhi-linux/version"
    exit 0
else
    TARGET="$APP/RhiLinux.Gui"
fi
if [ -z "${FONTCONFIG_FILE:-}" ]; then
    if [ -f /etc/fonts/fonts.conf ]; then
        export FONTCONFIG_FILE=/etc/fonts/fonts.conf
    else
        export FONTCONFIG_FILE="$HERE/usr/share/rhi-linux/fonts.conf"
    fi
fi
if [ -z "${SSL_CERT_FILE:-}" ]; then
    for CERT in /etc/ssl/certs/ca-certificates.crt /etc/ssl/cert.pem /etc/pki/tls/certs/ca-bundle.crt; do
        if [ -f "$CERT" ]; then
            export SSL_CERT_FILE="$CERT"
            break
        fi
    done
fi
unset LD_LIBRARY_PATH LD_PRELOAD
exec "$APP/ld-linux-x86-64.so.2" --library-path "$APP/native:$APP" "$TARGET" "$@"
